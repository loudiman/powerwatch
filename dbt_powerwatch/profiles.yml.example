# Copy to profiles.yml (gitignored) and fill in, or rely on the env vars below.
powerwatch:
  target: dev
  outputs:
    dev:
      type: bigquery
      method: oauth   # gcloud Application Default Credentials: `gcloud auth application-default login`
      project: "{{ env_var('GCP_PROJECT_ID') }}"
      dataset: "{{ env_var('BQ_DATASET', 'powerwatch') }}"
      location: "{{ env_var('GCP_REGION', 'US') }}"
      threads: 4
      priority: interactive
